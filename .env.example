# ==============================================================================
# QueueBuddy – Bengaluru Configuration
# ==============================================================================

# Supabase Configuration
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Test Configuration (for UPI & Card testing)
# Found in Razorpay Dashboard -> Settings -> API Keys (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_1234567890abcdef
RAZORPAY_KEY_SECRET=your_test_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Maps Provider (MapLibre GL is free and defaults to OpenStreetMap raster/vector tiles)
# Options: 'osm' (default, free OSM tiles) | 'maptiler' | 'mapbox'
NEXT_PUBLIC_MAP_PROVIDER=osm
# Optional MapTiler/Mapbox Key if provider is set to maptiler or mapbox
NEXT_PUBLIC_MAP_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo / Offline Simulation Mode
# When 'true', allows full end-to-end testing with mock Supabase & test payment out-of-the-box
NEXT_PUBLIC_DEMO_MODE=true
